[push]
	default = current
[merge]
	tool = kdiff3
[diff]
	tool = kdiff3
[url "git@github.com:"]
	insteadOf = https://github.com/
[color]
	ui = auto
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	defaultBranch = main
